# Google AI Studio -> API key -> used for PDF report extraction (backend/services/pdf_extraction.py)
GEMINI_API_KEY=

# console.anthropic.com -> used for clinical narrative generation (backend/services/explanation.py)
ANTHROPIC_API_KEY=

# Supabase project settings -> API -> Project URL
SUPABASE_URL=

# Supabase project settings -> API -> service_role key (server-side only, NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings -> API -> anon public key (frontend client queries)
VITE_SUPABASE_ANON_KEY=

# FastAPI backend server URL for frontend API client (src/config/constants.ts)
VITE_API_BASE_URL=

# pro.reactbits.dev account -> only needed when installing/reinstalling React Bits Pro components
REACTBITS_LICENSE_KEY=
